cabal-version:       3.0
name:                log-hs-opentelemetry
version:             0.1.0.0
synopsis:            Structured logging solution (OpenTelemetry back end)

description:         OpenTelemetry back end for the 'log' library suite.
                     Forwards log messages to the OpenTelemetry Logs
                     pipeline of 'hs-opentelemetry-api'.
                     Depends on 'log-base'.

homepage:            https://github.com/scrive/log
license:             BSD-3-Clause
license-file:        LICENSE
author:              Scrive AB
maintainer:          Andrzej Rybczak <andrzej@rybczak.net>,
                     Jonathan Jouty <jonathan@scrive.com>,
                     Mikhail Glushenkov <mikhail@scrive.com>,
                     Oleg Grenrus <oleg.grenrus@iki.fi>
copyright:           Scrive AB
category:            System
build-type:          Simple
extra-source-files:  CHANGELOG.md, README.md
tested-with:         GHC == { 9.6.7, 9.8.4, 9.10.2, 9.12.2 }

Source-repository head
  type:     git
  location: https://github.com/scrive/log.git

common common-stanza
  ghc-options:        -Wall

  default-language:   Haskell2010
  default-extensions: FlexibleContexts
                    , LambdaCase
                    , OverloadedStrings
                    , RecordWildCards
                    , ScopedTypeVariables

library
  import:             common-stanza

  exposed-modules:    Log.Backend.OpenTelemetry
  build-depends:      base                  >= 4.13  && < 5
                    , aeson                 >= 2.0.1
                    , hs-opentelemetry-api  >= 1.0   && < 1.1
                    , log-base              >= 0.12  && < 0.13
                    , scientific            >= 0.3
                    , time                  >= 1.6
                    , unliftio-core         >= 0.2
                    , unordered-containers  >= 0.2

  hs-source-dirs:     src

test-suite log-hs-opentelemetry-test
  import:             common-stanza

  type:               exitcode-stdio-1.0
  main-is:            Main.hs
  hs-source-dirs:     test
  ghc-options:        -threaded

  build-depends:      base
                    , aeson
                    , hs-opentelemetry-api
                    , hs-opentelemetry-exporter-in-memory >= 1.0 && < 1.1
                    , hs-opentelemetry-sdk                >= 1.0 && < 1.1
                    , hspec                               >= 2.7
                    , log-base
                    , log-hs-opentelemetry
                    , unordered-containers
